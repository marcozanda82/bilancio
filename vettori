// 1 & 2: Punta-Coda
function GraphicalExercise({ mode }) {
  const svgRef = useRef(null);
  const SNAP_DISTANCE = 25;
  const isDiff = mode === 'diff';

  const generateRandomVectors = () => {
    const r = () => (Math.floor(Math.random() * 5) + 3) * 20 * (Math.random() > 0.5 ? 1 : -1);
    return [
      { id: 'v1', x: 150, y: 150, dx: Math.abs(r()), dy: -Math.abs(r()), color: '#ef4444', label: 'a', isFlipped: false },
      { id: 'v2', x: 50, y: 250, dx: r(), dy: r(), color: '#3b82f6', label: 'b', isFlipped: false }
    ];
  };

  const [vectors, setVectors] = useState(generateRandomVectors());
  const [resultant, setResultant] = useState(null);
  const [dragging, setDragging] = useState(null);
  const [success, setSuccess] = useState(false);

  const getMouseCoords = (e) => {
    const CTM = svgRef.current.getScreenCTM();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: (clientX - CTM.e) / CTM.a, y: (clientY - CTM.f) / CTM.d };
  };

  const handlePointerDown = (e, id) => {
    e.preventDefault();
    const coords = getMouseCoords(e);
    const vec = vectors.find(v => v.id === id);
    setDragging({ id, offsetX: coords.x - vec.x, offsetY: coords.y - vec.y });
  };

  const handlePointerMove = (e) => {
    if (!dragging) return;
    e.preventDefault();
    const coords = getMouseCoords(e);
    setVectors(prev => prev.map(v => v.id === dragging.id ? { ...v, x: coords.x - dragging.offsetX, y: coords.y - dragging.offsetY } : v));
    setResultant(null);
    setSuccess(false);
  };

  const handlePointerUp = () => {
    if (!dragging) return;
    const dragged = vectors.find(v => v.id === dragging.id);
    let snappedToId = null;
    let isSecond = false;
    let newX = dragged.x;
    let newY = dragged.y;

    vectors.forEach(target => {
      if (target.id === dragging.id) return;
      if (Math.hypot(dragged.x - (target.x + target.dx), dragged.y - (target.y + target.dy)) < SNAP_DISTANCE) {
        newX = target.x + target.dx; newY = target.y + target.dy; snappedToId = target.id; isSecond = true;
      } else if (Math.hypot((dragged.x + dragged.dx) - target.x, (dragged.y + dragged.dy) - target.y) < SNAP_DISTANCE) {
        newX = target.x - dragged.dx; newY = target.y - dragged.dy; snappedToId = target.id; isSecond = false;
      }
    });

    if (snappedToId) {
      setVectors(prev => prev.map(v => v.id === dragging.id ? { ...v, x: newX, y: newY } : v));
      const first = isSecond ? vectors.find(v => v.id === snappedToId) : { ...dragged, x: newX, y: newY };
      const second = isSecond ? { ...dragged, x: newX, y: newY } : vectors.find(v => v.id === snappedToId);
      setResultant({ x: first.x, y: first.y, dx: (second.x + second.dx) - first.x, dy: (second.y + second.dy) - first.y });
      const vB = vectors.find(v => v.id === 'v2');
      if (isDiff) { if (vB.isFlipped) setSuccess(true); } 
      else { if (!vB.isFlipped) setSuccess(true); }
    } else {
      setVectors(prev => prev.map(v => v.id === dragging.id ? { ...v, x: newX, y: newY } : v));
    }
    setDragging(null);
  };

  const flipVectorB = () => {
    setVectors(prev => prev.map(v => v.id === 'v2' ? { ...v, dx: -v.dx, dy: -v.dy, isFlipped: !v.isFlipped, label: v.isFlipped ? 'b' : '-b' } : v));
    setResultant(null);
    setSuccess(false);
  };

  const nextExercise = () => {
    setVectors(generateRandomVectors());
    setResultant(null);
    setSuccess(false);
  };

  const renderVector = (v, isRes = false) => {
    const angle = Math.atan2(v.dy, v.dx) * (180 / Math.PI);
    const length = Math.hypot(v.dx, v.dy);
    return (
      <g key={v.id || 'res'} transform={`translate(${v.x}, ${v.y})`} onPointerDown={!isRes ? e => handlePointerDown(e, v.id) : undefined} style={{ cursor: !isRes ? 'grab' : 'default', opacity: isRes ? 0.8 : 1 }}>
        {!isRes && <line x1="0" y1="0" x2={v.dx} y2={v.dy} stroke="transparent" strokeWidth="25" />}
        <line x1="0" y1="0" x2={v.dx} y2={v.dy} stroke={isRes ? '#22c55e' : v.color} strokeWidth={isRes ? "6" : "4"} strokeDasharray={isRes ? "8,4" : "none"} />
        <polygon points={`${length},0 ${length-15},-6 ${length-15},6`} fill={isRes ? '#22c55e' : v.color} transform={`rotate(${angle})`} />
        <text x={v.dx/2} y={v.dy/2 - 12} fill={isRes ? '#166534' : v.color} fontWeight="bold" fontSize="16" pointerEvents="none">{isRes ? (isDiff ? 'd = a - b' : 's = a + b') : `${v.label}⃗`}</text>
        {!isRes && <circle cx="0" cy="0" r="6" fill="white" stroke={v.color} strokeWidth="2" pointerEvents="none" />}
      </g>
    );
  };

  return (
    <div className="space-y-4">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center bg-slate-100 p-4 rounded-lg">
        <div>
          <h3 className="font-bold text-slate-800">{isDiff ? 'Calcola la Differenza (a - b)' : 'Calcola la Somma (a + b)'}</h3>
          <p className="text-sm text-slate-600">Trascina i vettori per agganciarli punta-coda.</p>
        </div>
        <div className="mt-2 md:mt-0 flex gap-2">
          {isDiff && <button onClick={flipVectorB} className="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1.5 rounded font-bold text-sm flex items-center"><CornerUpLeft className="w-4 h-4 mr-1"/> Inverti b (-b)</button>}
          <button onClick={nextExercise} className="bg-slate-300 hover:bg-slate-400 text-slate-800 px-3 py-1.5 rounded font-bold text-sm flex items-center"><RefreshCw className="w-4 h-4 mr-1"/> Nuovo</button>
        </div>
      </div>
      
      <div className={`border-4 rounded-xl overflow-hidden touch-none relative ${success ? 'border-green-400 shadow-[0_0_15px_rgba(74,222,128,0.5)]' : 'border-slate-200'}`} style={{ height: '400px' }}>
        <svg ref={svgRef} width="100%" height="100%" onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerLeave={handlePointerUp} className="bg-slate-50 touch-none">
          <defs><pattern id="gridbg" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" strokeWidth="1"/></pattern></defs>
          <rect width="100%" height="100%" fill="url(#gridbg)" />
          {resultant && renderVector(resultant, true)}
          {vectors.map(v => renderVector(v))}
        </svg>
        {success && <div className="absolute bottom-4 left-1/2 -translate-x-1/2 bg-green-500 text-white px-4 py-2 rounded-full font-bold shadow-lg animate-bounce">Perfetto! Esercizio Corretto! 🎉</div>}
        {resultant && !success && <div className="absolute bottom-4 left-1/2 -translate-x-1/2 bg-red-500 text-white px-4 py-2 rounded-full font-bold shadow-lg">Risultante trovata, ma non è l'operazione richiesta. Riprova!</div>}
      </div>
    </div>
  );
}

// 3. Proiezioni Interattive
function ProjectionExercise() {
  const svgRef = useRef(null);
  const centerX = 200;
  const centerY = 200;
  
  const [tip, setTip] = useState({ x: 300, y: 100 });
  const [dragging, setDragging] = useState(false);

  const getMouseCoords = (e) => {
    const CTM = svgRef.current.getScreenCTM();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    let newX = (clientX - CTM.e) / CTM.a;
    let newY = (clientY - CTM.f) / CTM.d;
    newX = Math.max(20, Math.min(newX, 380));
    newY = Math.max(20, Math.min(newY, 380));
    return { x: newX, y: newY };
  };

  const handlePointerDown = (e) => {
    e.preventDefault();
    setDragging(true);
    setTip(getMouseCoords(e));
  };

  const handlePointerMove = (e) => {
    if (!dragging) return;
    e.preventDefault();
    setTip(getMouseCoords(e));
  };

  const handlePointerUp = () => setDragging(false);

  const dx = tip.x - centerX;
  const dy = centerY - tip.y; 
  
  const unitaX = (dx / 10).toFixed(1);
  const unitaY = (dy / 10).toFixed(1);
  
  const moduloPx = Math.hypot(dx, dy);
  const moduloVal = (moduloPx / 10).toFixed(1);
  
  let angoloRad = Math.atan2(dy, dx);
  let angoloDeg = Math.round(angoloRad * (180 / Math.PI));
  if (angoloDeg < 0) angoloDeg += 360;

  const drawVector = (x1, y1, x2, y2, color, isDashed = false) => {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const angle = Math.atan2(dy, dx) * (180 / Math.PI);
    const length = Math.hypot(dx, dy);
    if(length < 1) return null;
    return (
      <g transform={`translate(${x1}, ${y1})`}>
        <line x1="0" y1="0" x2={length} y2="0" stroke={color} strokeWidth="3" strokeDasharray={isDashed ? "5,5" : "none"} transform={`rotate(${angle})`}/>
        {!isDashed && <polygon points={`${length},0 ${length-10},-5 ${length-10},5`} fill={color} transform={`rotate(${angle})`} />}
      </g>
    );
  };

  const r = 30;
  const startAngle = 0;
  const endAngle = -angoloRad; 
  const startX = centerX + r;
  const startY = centerY;
  const endX = centerX + r * Math.cos(endAngle);
  const endY = centerY + r * Math.sin(endAngle);
  const largeArcFlag = angoloDeg > 180 ? 1 : 0;
  const arcPath = `M ${startX} ${startY} A ${r} ${r} 0 ${largeArcFlag} 0 ${endX} ${endY}`;

  return (
    <div className="grid md:grid-cols-2 gap-6">
      <div className="bg-white p-4 rounded-xl border border-slate-200">
        <h3 className="font-bold text-slate-800 mb-2 flex items-center">
          <Target className="w-5 h-5 mr-2 text-indigo-600"/>
          Piano Cartesiano Interattivo
        </h3>
        <p className="text-sm text-slate-500 mb-4">Trascina la punta del vettore v (verde) per esplorare come cambiano le sue componenti (ombre).</p>
        
        <div className="border border-slate-200 rounded-xl overflow-hidden bg-slate-50 flex justify-center touch-none">
          <svg 
            ref={svgRef} width="400" height="400" viewBox="0 0 400 400"
            onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerLeave={handlePointerUp}
          >
            <defs><pattern id="gridbg-small" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="#f1f5f9" strokeWidth="1"/></pattern></defs>
            <rect width="100%" height="100%" fill="url(#gridbg-small)" />
            
            <line x1="0" y1={centerY} x2="400" y2={centerY} stroke="#94a3b8" strokeWidth="2" />
            <line x1={centerX} y1="0" x2={centerX} y2="400" stroke="#94a3b8" strokeWidth="2" />
            <text x="380" y={centerY - 10} fill="#64748b" fontSize="14" fontWeight="bold">X</text>
            <text x={centerX + 10} y="20" fill="#64748b" fontSize="14" fontWeight="bold">Y</text>

            {moduloPx > 0 && (
              <>
                <path d={arcPath} fill="none" stroke="#a855f7" strokeWidth="2" />
                <text x={centerX + r * Math.cos(endAngle/2) + (angoloDeg > 180 ? -15 : 10)} 
                      y={centerY + r * Math.sin(endAngle/2) + (angoloDeg > 180 ? -10 : 5)} 
                      fill="#a855f7" fontSize="12" fontWeight="bold">α</text>
              </>
            )}

            <line x1={tip.x} y1={tip.y} x2={tip.x} y2={centerY} stroke="#ef4444" strokeWidth="1" strokeDasharray="4,4" />
            <line x1={tip.x} y1={tip.y} x2={centerX} y2={tip.y} stroke="#3b82f6" strokeWidth="1" strokeDasharray="4,4" />

            {drawVector(centerX, centerY, tip.x, centerY, '#ef4444')} 
            {drawVector(centerX, centerY, centerX, tip.y, '#3b82f6')} 

            {drawVector(centerX, centerY, tip.x, tip.y, '#22c55e')}
            <text x={tip.x + 10} y={tip.y - 10} fill="#166534" fontWeight="bold" fontSize="18">v⃗</text>

            <circle cx={tip.x} cy={tip.y} r="25" fill="transparent" style={{ cursor: 'grab' }} onPointerDown={handlePointerDown} />
            <circle cx={tip.x} cy={tip.y} r="6" fill="white" stroke="#22c55e" strokeWidth="3" pointerEvents="none" />
          </svg>
        </div>
      </div>

      <div className="bg-white p-6 rounded-xl border border-slate-200 flex flex-col justify-center">
        <h3 className="font-bold text-slate-800 mb-6 text-xl">Dati in Tempo Reale</h3>
        
        <div className="space-y-6">
          <div className="flex items-center justify-between p-3 bg-green-50 rounded-lg border border-green-200">
             <span className="font-bold text-green-800">Modulo (v):</span>
             <span className="text-xl font-mono">{moduloVal} u</span>
          </div>

          <div className="flex items-center justify-between p-3 bg-purple-50 rounded-lg border border-purple-200">
             <span className="font-bold text-purple-800">Angolo (α):</span>
             <span className="text-xl font-mono">{angoloDeg}°</span>
          </div>

          <div className="space-y-3">
             <div className="p-4 bg-red-50 rounded-lg border border-red-200">
               <div className="flex justify-between items-center mb-1">
                 <span className="font-bold text-red-800">Comp. X (Coseno):</span>
                 <span className="text-xl font-mono text-red-600">{unitaX}</span>
               </div>
               <div className="text-sm text-red-500 font-mono">
                 v_x = {moduloVal} &middot; cos({angoloDeg}°) = {unitaX}
               </div>
