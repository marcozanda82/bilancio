               </div>
             </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// 4. Metodo Analitico (Versione Classica)
function AnalyticalExercise() {
  const angoli = [0, 30, 45, 60, 90, 120, 150, 180];
  const moduli = [10, 20, 30, 40, 50];

  const generateData = () => {
    const a1 = angoli[Math.floor(Math.random() * angoli.length)];
    const a2 = angoli[Math.floor(Math.random() * angoli.length)];
    const m1 = moduli[Math.floor(Math.random() * moduli.length)];
    const m2 = moduli[Math.floor(Math.random() * moduli.length)];
    return {
      v1: { mod: m1, ang: a1, x: m1 * Math.cos(a1 * Math.PI / 180), y: m1 * Math.sin(a1 * Math.PI / 180) },
      v2: { mod: m2, ang: a2, x: m2 * Math.cos(a2 * Math.PI / 180), y: m2 * Math.sin(a2 * Math.PI / 180) }
    };
  };

  const [data, setData] = useState(generateData());
  const [answers, setAnswers] = useState({ v1x: '', v1y: '', v2x: '', v2y: '', sx: '', sy: '', stot: '' });
  const [feedback, setFeedback] = useState(null);

  const checkAnswers = () => {
    const expectedSx = data.v1.x + data.v2.x;
    const expectedSy = data.v1.y + data.v2.y;
    const expectedStot = Math.hypot(expectedSx, expectedSy);
    
    // Tolleranza per arrotondamenti
    const tolleranza = 1.0; 
    
    const isCorrect = (val, expected) => Math.abs(parseFloat(val) - expected) <= tolleranza;

    if (
      isCorrect(answers.v1x, data.v1.x) && isCorrect(answers.v1y, data.v1.y) &&
      isCorrect(answers.v2x, data.v2.x) && isCorrect(answers.v2y, data.v2.y) &&
      isCorrect(answers.sx, expectedSx) && isCorrect(answers.sy, expectedSy) &&
      isCorrect(answers.stot, expectedStot)
    ) {
      setFeedback({ type: 'success', text: 'Tutti i calcoli sono perfetti! Bravissimo! 🏆' });
    } else {
      setFeedback({ type: 'error', text: 'Ci sono degli errori (ricorda i segni negativi e usa almeno 1 decimale). Riprova!' });
    }
  };

  const newExercise = () => {
    setData(generateData());
    setAnswers({ v1x: '', v1y: '', v2x: '', v2y: '', sx: '', sy: '', stot: '' });
    setFeedback(null);
  };

  // Disegno semplice del vettore sul canvas SVG cartesiano
  const drawVector = (v, color, label) => {
    const scale = 3; 
    const svgX = 150 + (v.x * scale);
    const svgY = 150 - (v.y * scale);
    return (
      <g key={label}>
        <line x1="150" y1="150" x2={svgX} y2={svgY} stroke={color} strokeWidth="3" />
        <circle cx={svgX} cy={svgY} r="4" fill={color} />
        <text x={svgX + 5} y={svgY - 5} fill={color} fontWeight="bold" fontSize="14">{label}</text>
      </g>
    );
  };

  return (
    <div className="grid md:grid-cols-2 gap-6">
      {/* Sinistra: Grafico Cartesiano */}
      <div className="bg-white p-4 rounded-xl border border-slate-200 flex flex-col items-center justify-center">
        <h3 className="font-bold mb-4 text-slate-800 text-lg">Il Problema</h3>
        <svg width="300" height="300" className="bg-slate-50 border border-slate-300 rounded">
          {/* Assi */}
          <line x1="0" y1="150" x2="300" y2="150" stroke="#cbd5e1" strokeWidth="2" />
          <line x1="150" y1="0" x2="150" y2="300" stroke="#cbd5e1" strokeWidth="2" />
          <text x="280" y="140" fill="#64748b" fontSize="12">X</text>
          <text x="160" y="20" fill="#64748b" fontSize="12">Y</text>
          
          {drawVector(data.v1, '#ef4444', 'a')}
          {drawVector(data.v2, '#3b82f6', 'b')}
        </svg>
        
        <div className="mt-6 w-full bg-slate-100 p-4 rounded-lg text-sm space-y-2">
          <p className="text-red-600 font-bold text-base">Vettore a: modulo = {data.v1.mod}, angolo = {data.v1.ang}°</p>
          <p className="text-blue-600 font-bold text-base">Vettore b: modulo = {data.v2.mod}, angolo = {data.v2.ang}°</p>
        </div>
      </div>

      {/* Destra: Calcoli e Form */}
      <div className="space-y-4">
        <div className="bg-yellow-50 border-l-4 border-yellow-400 p-3 text-sm">
          <strong>Usa la calcolatrice!</strong> Scomponi i vettori calcolando <em>modulo &middot; cos(angolo)</em> per la X, e <em>modulo &middot; sin(angolo)</em> per la Y. (Usa i decimali col punto, es: 17.3).
        </div>
        
        <div className="grid grid-cols-2 gap-4">
          <div className="space-y-2 p-3 bg-red-50 rounded border border-red-100">
            <h4 className="font-bold text-red-800 text-sm">Componenti di a</h4>
            <input type="number" placeholder="a_x (cos)" className="w-full p-2 border rounded bg-white" value={answers.v1x} onChange={e => setAnswers({...answers, v1x: e.target.value})} />
            <input type="number" placeholder="a_y (sin)" className="w-full p-2 border rounded bg-white" value={answers.v1y} onChange={e => setAnswers({...answers, v1y: e.target.value})} />
          </div>
          <div className="space-y-2 p-3 bg-blue-50 rounded border border-blue-100">
            <h4 className="font-bold text-blue-800 text-sm">Componenti di b</h4>
            <input type="number" placeholder="b_x (cos)" className="w-full p-2 border rounded bg-white" value={answers.v2x} onChange={e => setAnswers({...answers, v2x: e.target.value})} />
            <input type="number" placeholder="b_y (sin)" className="w-full p-2 border rounded bg-white" value={answers.v2y} onChange={e => setAnswers({...answers, v2y: e.target.value})} />
          </div>
        </div>

        <div className="p-3 bg-green-50 rounded border border-green-200 space-y-2">
          <h4 className="font-bold text-green-800 text-sm">Somma (S)</h4>
          <div className="flex gap-2">
             <input type="number" placeholder="S_x (a_x + b_x)" className="w-1/2 p-2 border rounded bg-white" value={answers.sx} onChange={e => setAnswers({...answers, sx: e.target.value})} />
             <input type="number" placeholder="S_y (a_y + b_y)" className="w-1/2 p-2 border rounded bg-white" value={answers.sy} onChange={e => setAnswers({...answers, sy: e.target.value})} />
          </div>
          <input type="number" placeholder="Modulo S Totale (Usa Pitagora)" className="w-full p-2 border rounded font-bold bg-white" value={answers.stot} onChange={e => setAnswers({...answers, stot: e.target.value})} />
        </div>

        {feedback && (
          <div className={`p-3 rounded font-bold text-sm ${feedback.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
            {feedback.text}
          </div>
        )}

        <div className="flex gap-2 pt-2">
          <button onClick={checkAnswers} className="flex-1 bg-slate-800 text-white font-bold py-2 rounded hover:bg-slate-700 flex justify-center items-center"><Calculator className="w-5 h-5 mr-2"/> Verifica Calcoli</button>
          <button onClick={newExercise} className="bg-slate-200 text-slate-800 p-2 rounded hover:bg-slate-300" title="Nuovo Esercizio"><RefreshCw className="w-5 h-5"/></button>
        </div>
      </div>
    </div>
  );
}

