function QuizView() {
  const [currentQ, setCurrentQ] = useState(0);
  const [selectedOpt, setSelectedOpt] = useState(null);
  const [showResult, setShowResult] = useState(false);
  const [score, setScore] = useState(0);
  const q = quizQuestions[currentQ];

  const handleSelect = (idx) => {
    if (showResult) return;
    setSelectedOpt(idx);
    setShowResult(true);
    if (idx === q.correct) setScore(score + 1);
  };
  const nextQuestion = () => { setSelectedOpt(null); setShowResult(false); setCurrentQ(prev => prev + 1); };
  const resetQuiz = () => { setCurrentQ(0); setSelectedOpt(null); setShowResult(false); setScore(0); };

  if (currentQ >= quizQuestions.length) {
    return (
      <div className="max-w-lg mx-auto text-center mt-12 bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 className="text-3xl font-bold mb-4">Quiz Completato! 🚀</h2>
        <p className="text-xl mb-6">Hai risposto correttamente a {score} su {quizQuestions.length} domande.</p>
        <button onClick={resetQuiz} className="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">Ripeti il Quiz</button>
      </div>
    );
  }

  return (
    <div className="max-w-xl mx-auto mt-8 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div className="text-sm text-slate-500 mb-4 font-bold uppercase tracking-wider">Domanda {currentQ + 1} di {quizQuestions.length}</div>
      <h2 className="text-xl font-bold text-slate-800 mb-6">{q.question}</h2>
      <div className="space-y-3">
        {q.options.map((opt, idx) => {
          let btnClass = "w-full text-left p-4 rounded-lg border-2 transition-all ";
          if (!showResult) btnClass += "border-slate-200 hover:border-blue-400 hover:bg-blue-50";
          else if (idx === q.correct) btnClass += "border-green-500 bg-green-50 font-bold";
          else if (idx === selectedOpt) btnClass += "border-red-500 bg-red-50";
          else btnClass += "border-slate-200 opacity-50";
          return <button key={idx} onClick={() => handleSelect(idx)} className={btnClass} disabled={showResult}>{opt}</button>;
        })}
      </div>
      {showResult && (
        <div className={`mt-6 p-4 rounded-lg ${selectedOpt === q.correct ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
          <p className="font-bold mb-1">{selectedOpt === q.correct ? 'Esatto! 🎉' : 'Ops! Sbagliato.'}</p>
          <p className="text-sm">{q.explanation}</p>
          <button onClick={nextQuestion} className="mt-4 bg-slate-800 text-white px-4 py-2 rounded font-bold hover:bg-slate-700">
            {currentQ < quizQuestions.length - 1 ? 'Prossima Domanda' : 'Vedi Risultati'}
          </button>
        </div>
      )}
    </div>
  );
}

